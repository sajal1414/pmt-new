# Copy this file to server/.env and fill in your values. server/.env is not committed to Git.
# The API reads it on start (restart `npm run dev` after changing it).

# --- Database (PostgreSQL) ---
# Connection URL from your provider (Neon, Supabase, Render…), usually ending in ?sslmode=require.
# Left empty, the API keeps using the JSON file server/data/atlas.json.
# The first start with an empty database copies atlas.json into it (or starts empty when there's no atlas.json).
# Required in production: the server's own disk is wiped on most hosts at every deploy.
DATABASE_URL=

# --- Razorpay (online payment) ---
# Dashboard → Settings → API Keys. Use the TEST keys (rzp_test_…) while testing: no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Currency sent to Razorpay and shown to learners. Course prices are stored as plain numbers in this currency.
# INR works on every Razorpay account; USD needs "International payments" enabled on the account.
PAYMENT_CURRENCY=USD

# "COD (testing)": learners can enroll without paying, recorded as a pending payment. Keep false on the live site.
PAYMENT_COD=false

# --- Running live (production) ---
# On the live server set NODE_ENV=production: it turns on the checks below (the server won't start without
# ATLAS_SECRET). Leave it unset on your own computer.
# NODE_ENV=production
# PORT=4000

# Signs the sign-in cookies. A long random value, kept the same between deploys (changing it signs everyone out).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATLAS_SECRET=

# The first admin account, created on the very first start of an empty database.
# The admin is asked to choose a new password at first sign-in; after that these are no longer used.
ATLAS_ADMIN_EMAIL=admin@hazdemy.com
ATLAS_ADMIN_PASSWORD=

# Set to 1 when the app runs behind a proxy or load balancer you control (Render, Railway, nginx), so the
# real visitor address is used for sign-in throttling.
# ATLAS_TRUST_PROXY=1

# Extra web addresses allowed to send changes to the API, comma separated. Not needed when the site and API
# share one address (the normal setup). Websites showing courses use keys from Website API instead.
ATLAS_ALLOWED_ORIGINS=

# 1 = fill an empty database with example courses, instructors and learners (demos only, never on the live site).
ATLAS_SAMPLE_DATA=

# --- Email (SMTP) ---------------------------------------------------------------------------------
# Leave SMTP_HOST empty to send no email. Restart the server after changing these.
# Microsoft 365 / Outlook:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  (SMTP AUTH must be on for the mailbox)
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  (use an App Password, not your normal one)
SMTP_HOST=
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# the sender people see, e.g. Hazdemy Training <training@yourcompany.com>
MAIL_FROM=
